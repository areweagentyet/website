---
import Layout from '../../layouts/Layout.astro';
import Readiness from '../../components/Readiness.astro';
import Icon from '../../components/Icon.astro';
import { catalog, tasks, kindLabels, formatDate, type Entry } from '../../lib/catalog';
export function getStaticPaths() { return catalog.map(entry => ({ params: { slug: entry.slug }, props: { entry } })); }
interface Props { entry: Entry }
const { entry } = Astro.props;
const a = entry.assessment;
const alternatives = catalog.filter(e => e.slug !== entry.slug && e.subsection === entry.subsection && e.kind === entry.kind).sort((x,y) => Number(!!y.assessment)-Number(!!x.assessment) || x.name.localeCompare(y.name)).slice(0, 4);
const dimensions = a ? [['Adoption signals', a.adoption], ['Developer experience', a.dx], ['Maintenance', a.maintenance], ['Compatibility & access', a.compatibility]] : [];
---
<Layout title={entry.name} description={entry.summary}>
  <article class="solution-page container" data-domain={entry.domainId}>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/#catalog">Explore</a><span>/</span><a href={`/stack/?domain=${entry.domainId}#catalog`}>{entry.domain}</a><span>/</span><span aria-current="page">{entry.name}</span></nav>
    <header class="solution-header"><div><span class="eyebrow">{kindLabels[entry.kind]} / {entry.subsection}</span><h1>{entry.name}</h1><p>{entry.summary}</p></div><div class="solution-header-status"><Readiness value={entry.readiness} />{a ? <span>Evidence reviewed<br /><time datetime={a.reviewed}>{formatDate(a.reviewed)}</time></span> : <span>Catalog entry<br />Assessment pending</span>}</div></header>
    <div class="solution-actions"><a class="button primary" href={entry.urls[0]} target="_blank" rel="noopener">Official source <Icon name="diagonal" size={17} /></a><button class="button compare-toggle" type="button" data-compare={entry.slug} aria-pressed="false" aria-label={`Add ${entry.name} to comparison`}><Icon name="plus" size={17} /><span data-compare-label>Add to comparison</span></button><a class="text-button" href="/methodology/">What does readiness mean? <Icon name="diagonal" size={15} /></a></div>
    <div class="solution-body"><div class="solution-primary">
      {a ? <>
        <section class="verdict-section"><span class="eyebrow">THE EDITORIAL ASSESSMENT</span><h2>Where it stands.</h2><p class="verdict-copy">{a.verdict}</p><p class="muted small">A desk review of published evidence. We have not benchmarked or audited this software.</p></section>
        <section class="dimension-section"><h2>Behind the verdict.</h2>{dimensions.map(([label, value]) => <div class="dimension-row"><h3>{label}</h3><p>{value}</p></div>)}</section>
        <section class="limitations-section"><span class="eyebrow">CONSTRAINTS & INTEGRATION WORK</span><h2>What to watch for.</h2><ul>{a.limitations.map(l => <li>{l}</li>)}</ul><p class="muted small">These are documented constraints or editorial implications of the architecture, not an exhaustive defect list.</p></section>
        <section class="evidence-section" id="evidence"><span class="eyebrow">PRIMARY SOURCES / {formatDate(a.reviewed)}</span><h2>Follow the evidence.</h2>{a.evidence.map((e, i) => <a class="evidence-link" href={e.url} target="_blank" rel="noopener"><span class="evidence-number">{String(i+1).padStart(2,'0')}</span><div><h3>{e.title}</h3><p>{e.note}</p><span>{new URL(e.url).hostname}</span></div><Icon name="diagonal" size={18} /></a>)}</section>
      </> : <section class="unassessed-section"><span class="eyebrow">ASSESSMENT PENDING</span><h2>On the map.<br /><em>Not yet reviewed.</em></h2><p>This entry is part of the original landscape. We haven't gathered enough evidence to publish a readiness verdict, adoption assessment or maintenance review.</p><p>“Not assessed” does not mean experimental, inactive or unsuitable. Follow the official sources to evaluate it for your application.</p><a class="inline-link" href="/methodology/#contributing">How to contribute an assessment <Icon name="arrow" size={18} /></a></section>}
      {entry.scope_note && <section class="catalog-context"><span class="eyebrow">FROM THE SOURCE CATALOG</span><h2>Scope & classification.</h2><p>{entry.scope_note}</p></section>}
    </div><aside class="solution-aside"><section><span class="eyebrow">AT A GLANCE</span><dl><div><dt>Space</dt><dd><a href={`/stack/?domain=${entry.domainId}#catalog`}>{entry.domain}</a></dd></div><div><dt>Entry type</dt><dd>{kindLabels[entry.kind]}</dd></div><div><dt>License / access</dt><dd>{a?.license ?? 'Not assessed'}</dd></div><div><dt>Interfaces / languages</dt><dd>{a?.languages.join(' · ') ?? 'Not assessed'}</dd></div><div><dt>Deployment</dt><dd>{a?.deployment ?? 'Not assessed'}</dd></div></dl></section><section><span class="eyebrow">RELATED DEVELOPER TASKS</span><div class="related-tasks">{entry.tasks.map(id => <a href={`/?task=${id}#catalog`}>{tasks.find(t => t.id === id)?.title}<Icon name="arrow" size={16} /></a>)}</div><p class="small muted">Task associations describe relevance, not verified integration.</p></section><section><span class="eyebrow">CATALOG SOURCES</span>{entry.urls.map((url, i) => <a class="source-url" href={url} target="_blank" rel="noopener">{i===0 ? 'Official source' : `Additional source ${i+1}`} <Icon name="diagonal" size={15} /></a>)}<p class="small muted">Source snapshot: September 2026, with October 5 additions. Catalog membership is not a readiness endorsement.</p>{entry.aliases.length > 0 && <p class="small muted">Also indexed as: {entry.aliases.join(', ')}</p>}</section></aside></div>
    {alternatives.length > 0 && <section class="alternatives"><div class="section-heading"><div><span class="eyebrow">MORE IN THIS SPACE</span><h2>Explore alongside.</h2></div><p>Related by catalog category.<br />Capabilities may differ.</p></div>{alternatives.map(e => <a class="alternative-row" href={`/solutions/${e.slug}/`}><strong>{e.name}</strong><span>{e.assessment?.summary ?? kindLabels[e.kind]}</span><Readiness value={e.readiness} /><Icon name="arrow" size={19} /></a>)}</section>}
  </article>
</Layout>
